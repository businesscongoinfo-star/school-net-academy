{
  "name": "school-net-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "School Net Academy — plateforme de gestion scolaire (Congo)",
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite web",
    "build": "vite build web",
    "build:demo": "DEMO=1 VITE_DEMO=1 vite build web",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "prestart": "node scripts/ensure-build.mjs",
    "snapshot": "node scripts/build-demo-snapshot.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "npm run typecheck && npm run build && node scripts/smoke.mjs && node scripts/audit.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
