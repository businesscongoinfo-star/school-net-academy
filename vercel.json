{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
